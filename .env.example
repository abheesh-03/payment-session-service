# Payment Session Service - development settings.
# Copy to .env (git-ignored) and replace the placeholders:
#   cp .env.example .env
# Both Docker Compose and the backend read the repository-root .env.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=payment_session
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=payment_session
# Host the backend connects to, and the host port published by Compose
# (bound to 127.0.0.1 only).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# --- Redis --------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=56380
REDIS_DB=0
# Prefix for every Redis key this project writes.
REDIS_KEY_PREFIX=payment-session-service
# Seconds a committed payment receipt stays cached in Redis (PostgreSQL is
# the durable copy; a cache miss just falls back to it).
RECEIPT_CACHE_TTL_SECONDS=600

# --- Backend ------------------------------------------------------------
# Comma-separated list of allowed browser origins (future Next.js frontend).
CORS_ORIGINS=http://localhost:3020
# Base URL of the checkout frontend. Responses include
# checkout_url = <FRONTEND_BASE_URL>/pay/<session id>.
FRONTEND_BASE_URL=http://localhost:3020

# Allow the X-Mock-Provider-Outcome: fail request header to simulate a
# payment-provider outage (development/testing only). When false, that header
# value is rejected with 422.
ENABLE_MOCK_FAILURES=false
